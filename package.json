{
  "name": "brass-charter",
  "private": true,
  "version": "0.1.0",
  "description": "Brass Charter: a turn-based war-walker skirmish game",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "typecheck": "tsc -p packages/rules --noEmit && tsc -p packages/ai --noEmit && tsc -p apps/web --noEmit",
    "test": "vitest run --testTimeout=30000",
    "check": "npm run validate && npm run typecheck && npm test",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "sim": "vite-node tools/sim/sim.ts --",
    "render": "node scripts/render-walkers.mjs",
    "fit": "node scripts/fit-check.mjs",
    "fit:sheets": "node scripts/fit-sheets.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "typescript": "^5.6.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
