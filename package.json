{
  "name": "brass-charter",
  "private": true,
  "version": "0.1.0",
  "description": "Brass Charter: a turn-based war-walker skirmish game",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "typecheck": "tsc -p packages/rules --noEmit && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "check": "npm run validate && npm run typecheck && npm test",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
